# Copy to .env for local development. Never commit .env.
SECRET_KEY=change-this-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Production values go in Vercel -> Project -> Settings -> Environment Variables:
#   SECRET_KEY                long random string
#   DATABASE_URL              added automatically by the Neon integration
#   FIREBASE_STORAGE_BUCKET   e.g. your-project.firebasestorage.app
#   FIREBASE_SERVICE_ACCOUNT  contents of the service-account JSON file
